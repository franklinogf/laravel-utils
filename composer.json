{
    "name": "franklinogf/laravel-utils",
    "description": "A set of utilities for laravel projects",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Franklin Gonzalez",
            "email": "franklinomarflores@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2.0",
        "laravel/framework": "^11.0|^12.0"
    },
    "scripts": {
        "refactor": "rector",
        "lint": "pint",
        "test:refactor": "rector --dry-run",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:unit": "pest --colors=always --coverage --min=100",
        "test:type-coverage": "pest --colors=always --parallel --type-coverage",
        "test": [
            "@test:refactor",
            "@test:lint",
            "@test:types",
            "@test:unit",
            "@test:type-coverage"
        ]
    },
    "autoload": {
        "psr-4": {
            "Franklinogf\\LaravelUtils\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Franklinogf\\LaravelUtils\\Providers\\LaravelUtilsServiceProvider"
            ]
        }
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "orchestra/testbench": "^10.6",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/phpstan": "^2.1.32",
        "rector/rector": "^2.2"
    }
}